{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned go install tool versions in Taskfile.yml (golangci-lint, govulncheck, gofumpt, goimports)",
      "managerFilePatterns": ["/^Taskfile\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Za-z0-9_]+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Pinned SCHEMA_REPO_SHA (embedded kubeconform schemas) in scripts/pull-schemas.sh - tracks the SCHEMA_REPO_BRANCH branch's tip commit",
      "managerFilePatterns": ["/^scripts/pull-schemas\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=git-refs\\s+depName=(?<depName>\\S+)\\s*\\n\\s*:\\s*\"\\$\\{SCHEMA_REPO_SHA:=(?<currentDigest>[0-9a-f]{40})\\}\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{depName}}",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Pinned CLI tool versions in Containerfile ARGs (GH_VERSION, GLAB_VERSION, KUSTOMIZE_VERSION, SHELLCHECK_VERSION, PRETTIER_VERSION, MARKDOWNLINT_CLI_VERSION)",
      "managerFilePatterns": ["/^Containerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*(versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_]+_VERSION:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group routine (non-major) Go dependency updates",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go dependencies"
    },
    {
      "description": "Isolate Go major bumps for manual review (module path suffix changes require source edits)",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group the Taskfile-pinned Go tool versions together",
      "matchFileNames": ["Taskfile.yml"],
      "matchDatasources": ["go"],
      "groupName": "taskfile go tools"
    },
    {
      "description": "Bump the go.mod go directive and the Containerfile golang base image together in one PR (they must always name the same release; task ci Step 1 enforces it)",
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang", "docker.io/library/golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "The go directive is treated as a range (^X.Y.Z), so Renovate never proposes a newer patch unless told to bump the value itself",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Go minor/major toolchain bumps need a deliberate decision; only patch releases (and digest refreshes) open automatically",
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang", "docker.io/library/golang"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true
    }
  ]
}
